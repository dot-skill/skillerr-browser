{
  "name": "skillerr-browser",
  "productName": "Skillerr",
  "version": "0.1.4",
  "description": "The browser any AI can drive, while you watch every step. Research memory, deep research, fleet view.",
  "main": "src/boot.js",
  "scripts": {
    "prestart": "node scripts/build-preview.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "premcp": "node scripts/build-preview.mjs",
    "mcp": "node mcp/bridge.js",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --x64 --publish never",
    "postdist": "node scripts/clean-dist.mjs",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --arm64 --publish never",
    "postdist:win": "node scripts/clean-dist.mjs",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux AppImage --x64 --arm64 --publish never",
    "postdist:linux": "node scripts/clean-dist.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build-preview.mjs",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node scripts/eval-recall.js",
    "dist:all": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --x64 --win nsis --x64 --arm64 --linux AppImage --x64 --arm64 --publish never",
    "postdist:all": "node scripts/clean-dist.mjs"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "author": {
    "name": "Bharat Dudeja"
  },
  "build": {
    "appId": "com.skillerr.browser",
    "productName": "Skillerr",
    "copyright": "© 2026 Bharat Dudeja",
    "asar": true,
    "directories": {
      "output": "dist",
      "app": "out"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Not used.",
        "NSMicrophoneUsageDescription": "Not used."
      }
    },
    "dmg": {
      "title": "Skillerr"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Skillerr",
      "artifactName": "Skillerr-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "maintainer": "Bharat Dudeja <support@skillerr.com>",
      "synopsis": "The browser any AI can drive, while you watch."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dot-skill",
        "repo": "skillerr-releases"
      }
    ],
    "protocols": [
      {
        "name": "Skillerr sign-in",
        "schemes": [
          "skillerr"
        ]
      }
    ]
  },
  "homepage": "https://skillerr.com"
}
